NODE_ENV=production
PORT=4000

# PostgreSQL — Neon or local
DATABASE_URL="postgresql://user:pass@host:5432/crm?schema=public&sslmode=require"
DATABASE_DIRECT_URL="postgresql://user:pass@host:5432/crm?schema=public&sslmode=require"

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_me_min_32_chars_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=429683C4C977415CAAFCCE10F7D57E11

# Webhook (this server's URL reachable from Evolution API)
WEBHOOK_SECRET=random_webhook_secret_token
WEBHOOK_URL=http://localhost:4000/webhook/evolution

# Telegram Bot (for reports)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CORS
FRONTEND_URL=http://localhost:3000

# Reports cron (default: every day at 08:00)
REPORT_CRON=0 8 * * *
