# ============================================================
# WhatsApp Lead CRM — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git!
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Timezone for all cron jobs, reports, night/day period logic
APP_TIMEZONE=Asia/Almaty

# ── Database (Neon PostgreSQL or self-hosted) ────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_use_openssl_rand_-hex_32
JWT_EXPIRES_IN=7d

# ── URLs ─────────────────────────────────────────────────────
# Backend public URL (used for webhook registration in Evolution API)
APP_URL=https://your-vps-domain.com
BACKEND_URL=https://your-vps-domain.com

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:5173

# WebSocket CORS
WS_CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:5173

# ── Evolution API ────────────────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=CHANGE_ME_your_evolution_api_key

# Optional: secret to verify webhook origin
EVOLUTION_WEBHOOK_SECRET=

# ── WhatsApp Instance names (4 аккаунта) ─────────────────────
# These must match instanceName in WhatsAppAccount records in DB
WHATSAPP_INSTANCE_1=whatsapp-1-tanat
WHATSAPP_INSTANCE_2=whatsapp-2
WHATSAPP_INSTANCE_3=whatsapp-3-ulday
WHATSAPP_INSTANCE_4=whatsapp-4

# ── Report Schedules (Asia/Almaty time) ──────────────────────
NIGHT_REPORT_GENERATION_TIME=09:00
DAY_REPORT_GENERATION_TIME=20:00

# ── File Storage ─────────────────────────────────────────────
EXCEL_STORAGE_PATH=./storage/reports

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
