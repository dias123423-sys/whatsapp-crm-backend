generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  OPERATOR
}

enum LeadStatus {
  NEW
  CALLING
  BOOKED
  FOLLOW_UP
  NO_ANSWER
  CLOSED
}

enum LeadSource {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  MANUAL
  OTHER
}

enum LeadPeriod {
  DAY
  NIGHT
}

enum WhatsAppStatus {
  ONLINE
  OFFLINE
  CONNECTING
}

enum AssignmentStrategy {
  ROUND_ROBIN
  LEAST_BUSY
  MANUAL
}

enum OperatorStatus {
  ACTIVE
  INACTIVE
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  passwordHash String
  name         String
  role         Role     @default(OPERATOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  operator  Operator?
  auditLogs AuditLog[]

  @@map("users")
}

// ─── Operators ────────────────────────────────────────────────────────────────

model Operator {
  id        String         @id @default(uuid())
  userId    String         @unique
  name      String
  phone     String?
  status    OperatorStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  leads Lead[]

  @@map("operators")
}

// ─── Procedures ───────────────────────────────────────────────────────────────

model Procedure {
  id          String   @id @default(uuid())
  name        String
  price       Float
  keywords    String[] // array of keyword strings
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads Lead[]

  @@map("procedures")
}

// ─── WhatsApp Accounts ────────────────────────────────────────────────────────

model WhatsAppAccount {
  id           String         @id @default(uuid())
  instanceName String         @unique
  phone        String?
  status       WhatsAppStatus @default(OFFLINE)
  sessionData  Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  messages Message[]

  @@map("whatsapp_accounts")
}

// ─── Clients ─────────────────────────────────────────────────────────────────

model Client {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  source    LeadSource @default(WHATSAPP)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads    Lead[]
  messages Message[]

  @@map("clients")
}

// ─── Leads ────────────────────────────────────────────────────────────────────

model Lead {
  id          String     @id @default(uuid())
  clientId    String
  operatorId  String?
  procedureId String?
  price       Float?
  source      LeadSource @default(WHATSAPP)
  status      LeadStatus @default(NEW)
  period      LeadPeriod @default(DAY)
  comment     String?
  result      String?
  assignedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  client    Client     @relation(fields: [clientId], references: [id])
  operator  Operator?  @relation(fields: [operatorId], references: [id])
  procedure Procedure? @relation(fields: [procedureId], references: [id])
  calls     Call[]
  history   LeadHistory[]

  @@map("leads")
}

// ─── Lead History ─────────────────────────────────────────────────────────────

model LeadHistory {
  id        String   @id @default(uuid())
  leadId    String
  event     String
  details   String?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])

  @@map("lead_history")
}

// ─── Messages ─────────────────────────────────────────────────────────────────

model Message {
  id                String   @id @default(uuid())
  clientId          String
  whatsappAccountId String?
  direction         String   // IN | OUT
  body              String
  rawPayload        Json?
  createdAt         DateTime @default(now())

  client          Client           @relation(fields: [clientId], references: [id])
  whatsappAccount WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id])

  @@map("messages")
}

// ─── Calls ────────────────────────────────────────────────────────────────────

model Call {
  id         String   @id @default(uuid())
  leadId     String
  calledAt   DateTime @default(now())
  duration   Int?     // seconds
  result     String?
  notes      String?

  lead Lead @relation(fields: [leadId], references: [id])

  @@map("calls")
}

// ─── Appointments ─────────────────────────────────────────────────────────────

model Appointment {
  id          String   @id @default(uuid())
  leadId      String   @unique
  scheduledAt DateTime
  notes       String?
  createdAt   DateTime @default(now())

  @@map("appointments")
}

// ─── Reports ──────────────────────────────────────────────────────────────────

model Report {
  id        String   @id @default(uuid())
  type      String   // NIGHT | DAILY | WEEKLY
  date      DateTime
  filePath  String?
  data      Json?
  createdAt DateTime @default(now())

  @@map("reports")
}

// ─── Assignment Config ────────────────────────────────────────────────────────

model AssignmentConfig {
  id       String             @id @default(uuid())
  strategy AssignmentStrategy @default(ROUND_ROBIN)
  lastIdx  Int                @default(0)
  updatedAt DateTime          @updatedAt

  @@map("assignment_config")
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
