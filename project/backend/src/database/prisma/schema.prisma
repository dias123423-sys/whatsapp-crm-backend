// This is your Prisma schema file
// Run: npx prisma migrate dev --name init --schema=src/database/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  output        = "../../../node_modules/.prisma/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

enum WhatsAppAccount {
  WA1
  WA2
  WA3
  WA4
}

enum CreatedBy {
  BOT
  OPERATOR
}

model Appointment {
  id               String          @id @default(cuid())
  clientName       String          @map("client_name")
  phone            String
  appointmentDate  DateTime        @map("appointment_date")
  appointmentTime  String          @map("appointment_time") // "14:00"
  whatsappAccount  WhatsAppAccount @map("whatsapp_account")
  createdBy        CreatedBy       @default(OPERATOR) @map("created_by")
  rawMessage       String?         @map("raw_message") @db.Text
  operatorName     String?         @map("operator_name")
  notes            String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([appointmentDate])
  @@index([whatsappAccount])
  @@index([createdBy])
  @@index([createdAt])
  @@map("appointments")
}

model WhatsAppSession {
  id          String          @id @default(cuid())
  accountId   String          @unique @map("account_id")
  isConnected Boolean         @default(false) @map("is_connected")
  phoneNumber String?         @map("phone_number")
  lastSeen    DateTime?       @map("last_seen")
  qrCode      String?         @map("qr_code") @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("whatsapp_sessions")
}

model ActivityLog {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  eventType String   @map("event_type")
  message   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([accountId])
  @@index([eventType])
  @@index([createdAt])
  @@map("activity_logs")
}
