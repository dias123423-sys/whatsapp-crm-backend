# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─────────────────────────────────────────────
# Database — PostgreSQL
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/callcenter?schema=public

# ─────────────────────────────────────────────
# JWT Auth
# ─────────────────────────────────────────────
JWT_SECRET=change_me_to_a_very_long_random_string_32_chars_min
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# Admin credentials (dashboard login)
# ─────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@2025!

# ─────────────────────────────────────────────
# CORS — Dashboard origin(s)
# Multiple: FRONTEND_URL=https://dash.example.com,https://192.168.1.100:3000
# ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Evolution API — runs on the SAME VPS at port 8080
# ─────────────────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=429683C4C977415CAAFCCE10F7D57E11

# ─────────────────────────────────────────────
# Webhook — URL where Evolution API will POST events
# Must be reachable from Evolution API container:
#   - same VPS → http://localhost:3001/webhook/evolution
#   - behind nginx → https://yourdomain.com/webhook/evolution
# ─────────────────────────────────────────────
WEBHOOK_URL=http://localhost:3001/webhook/evolution

# ─────────────────────────────────────────────
# WhatsApp instance names (must match Evolution API instance names)
# ─────────────────────────────────────────────
WA_INSTANCE_1=WA1
WA_INSTANCE_2=WA2
WA_INSTANCE_3=WA3
WA_INSTANCE_4=WA4

# ─────────────────────────────────────────────
# File paths
# ─────────────────────────────────────────────
REPORTS_DIR=./reports
