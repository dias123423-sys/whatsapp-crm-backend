# ─────────────────────────────────────────────────────────────────────────────
# Dashboard environment variables
# Copy to .env.local and fill in your VPS values.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API URL (VPS + nginx)
# For local dev:       http://localhost:3001
# For VPS (no HTTPS):  http://YOUR_VPS_IP_OR_DOMAIN
# For VPS (with SSL):  https://YOUR_DOMAIN
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN

# Socket.IO URL — must point directly to backend port (nginx proxies /socket.io/)
# Same value as NEXT_PUBLIC_API_URL when nginx is configured with socket.io location block
NEXT_PUBLIC_SOCKET_URL=https://YOUR_DOMAIN
